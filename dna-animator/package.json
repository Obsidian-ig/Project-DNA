{
	"name": "dna-animator",
	"productName": "DNA Animator",
	"description": "Animation Tool For Helix Rigs",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"main": "out/main/index.js",
	"trustedDependencies": [
		"electron"
	],
	"scripts": {
		"dev:renderer": "vite dev",
		"dev:main": "tsup src/main/index.ts --out-dir out/main --format esm --watch --external electron --publicDir src/main",
		"dev:preload": "tsup src/main/preload.ts --out-dir out/main --format cjs --watch --external electron",
		"build:main": "tsup src/main/index.ts --out-dir out/main --format esm --external electron --publicDir src/main",
		"build:preload": "tsup src/main/preload.ts --out-dir out/main --format cjs --external electron",
		"dev": "bun run build:main && bun run build:preload && concurrently --kill-others --success first \"bun run dev:renderer\" \"bun run dev:main\" \"bun run dev:preload\" \"bunx electron .\"",
		"build:renderer": "vite build",
		"package": "bun run build:renderer && bun run build:main && bun run build:preload && electron-builder"
	},
	"build": {
		"appId": "com.obsidiansoftware.dna-animator",
		"productName": "DNA Animator",
		"directories": {
			"output": "dist"
		},
		"files": [
			"out/**/*",
			"build/**/*",
			"package.json"
		],
		"win": {
			"target": "nsis",
			"icon": "src/main/favicon.ico"
		}
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "^26",
		"@vitest/browser-playwright": "^4.1.8",
		"concurrently": "^10.0.5",
		"electron": "^44.2.0",
		"electron-builder": "^26.15.3",
		"electron-vite": "^5.0.0",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"playwright": "^1.60.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"tsup": "^8.5.1",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.0.16",
		"vitest": "^4.1.8",
		"vitest-browser-svelte": "^2.1.1"
	},
	"dependencies": {
		"dockview": "^8.2.0",
		"electron-serve": "^3.0.1"
	}
}