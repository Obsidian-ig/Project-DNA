        {
            "mode": "default",
            "when": [
                [
                    "battery.percentage",
                    "<=",
                    "10"
                ]
            ],
            "do": [
                {
                    "mode": "set",
                    "parameter": "default_state",
                    "value": {
                        "id": "eye_state",
                        "state": "Sleepy",
                        "mode": "overridable"
                    }
                }
            ]
        },
        {
            "mode": "forced",
            "when": [
